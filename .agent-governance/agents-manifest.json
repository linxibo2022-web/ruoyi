      }
    },
    {
      "id": "init-docs",
      "runtimes": {
        "claude": { "kind": "command", "path": ".claude/commands/init-docs.md", "preloadable": false },
        "codex": { "kind": "skill", "path": ".agents/skills/init-docs/SKILL.md", "preloadable": true }
      }
    },
    {
      "id": "update-status",
      "runtimes": {
        "claude": { "kind": "command", "path": ".claude/commands/update-status.md", "preloadable": false },
        "codex": { "kind": "skill", "path": ".agents/skills/update-status/SKILL.md", "preloadable": true }
      }
    },
    {
      "id": "add-todo",
