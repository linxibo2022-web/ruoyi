# ==================== RocketMQ 集群环境配置 ====================
# 说明：此文件用于集中管理 RocketMQ 集群所有配置参数
# 架构：1 NameServer + 1 Master Broker + 1 Slave Broker + 1 Dashboard
# 使用方式：修改此文件后，执行 docker-compose -f RocketMQServer-compose.yml up -d 即可生效
# 网络模式：使用宿主机网络（network_mode: host），方便本地开发连接测试

# ==================== 基础配置 ====================
# 时区设置 - 统一使用上海时区
TZ=Asia/Shanghai

# RocketMQ 版本 - 推荐使用稳定版本 5.3.1
ROCKETMQ_VERSION=5.3.1

# Dashboard 版本 - 管理界面版本，latest为最新版
DASHBOARD_VERSION=latest

# ==================== NameServer 配置 ====================
# NameServer 地址 - Broker和Dashboard连接的NameServer地址（宿主机网络使用127.0.0.1）
# 多个地址用分号分隔，例如：127.0.0.1:9876;127.0.0.1:9877
NAMESRV_ADDR=127.0.0.1:9876

# NameServer JVM 参数 - 内存配置：初始堆512m，最大堆512m，新生代256m
NAMESRV_JAVA_OPTS=-Xms512m -Xmx512m -Xmn256m

# ==================== Broker Master 配置 ====================
# Broker Master JVM 参数 - 内存配置：初始堆1g，最大堆1g，新生代512m
# 说明：Master 负责接收写请求和读请求，建议配置较大内存
BROKER_MASTER_JAVA_OPTS=-Xms1g -Xmx1g -Xmn512m

# ==================== Broker Slave 配置 ====================
# Broker Slave JVM 参数 - 内存配置：初始堆1g，最大堆1g，新生代512m
# 说明：Slave 从 Master 同步数据，只处理读请求，可根据实际情况调整内存
BROKER_SLAVE_JAVA_OPTS=-Xms1g -Xmx1g -Xmn512m

# ==================== Dashboard 配置 ====================
# Dashboard 访问端口 - Web管理界面端口，8088
# 访问地址：http://localhost:8088
# 说明：在 host 网络模式下，此端口直接绑定到宿主机
DASHBOARD_PORT=8088

# Dashboard JVM 参数 - 内存配置：初始堆256m，最大堆256m
DASHBOARD_JAVA_OPTS=-Xms256m -Xmx256m

# Dashboard 登录认证 - 是否启用登录认证（true=启用, false=不需要登录）
DASHBOARD_LOGIN_ENABLED=false

# ==================== 存储配置 ====================
# 数据存储根目录 - 相对于 docker-compose.yml 的路径
# 存储内容：
#   - namesrv/logs: NameServer日志
#   - broker-master/logs: Master Broker日志
#   - broker-master/store: Master Broker消息存储
#   - broker-slave/logs: Slave Broker日志
#   - broker-slave/store: Slave Broker消息存储
#   - dashboard: Dashboard配置
DATA_DIR=./data

# ==================== 端口说明 ====================
# 以下端口由配置文件指定，无需修改：
#   - NameServer: 9876
#   - Broker Master: 10909, 10911, 10912
#   - Broker Slave: 10919, 10921, 10922
#   - Dashboard: 8088 (可通过 DASHBOARD_PORT 修改)

# ==================== 内存配置参考 ====================
# 开发环境（小型项目）：
#   - NameServer: -Xms256m -Xmx256m -Xmn128m
#   - Broker Master: -Xms512m -Xmx512m -Xmn256m
#   - Broker Slave: -Xms512m -Xmx512m -Xmn256m
#   - Dashboard: -Xms128m -Xmx128m
#
# 测试环境（中型项目）：
#   - NameServer: -Xms512m -Xmx512m -Xmn256m
#   - Broker Master: -Xms1g -Xmx1g -Xmn512m
#   - Broker Slave: -Xms1g -Xmx1g -Xmn512m
#   - Dashboard: -Xms256m -Xmx256m
#
# 生产环境（大型项目）：
#   - NameServer: -Xms1g -Xmx1g -Xmn512m
#   - Broker Master: -Xms2g -Xmx2g -Xmn1g
#   - Broker Slave: -Xms2g -Xmx2g -Xmn1g
#   - Dashboard: -Xms512m -Xmx512m
