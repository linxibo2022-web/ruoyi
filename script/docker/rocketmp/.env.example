# ==================== RocketMQ Server Docker 部署配置示例 ====================
# 复制此文件为 .env 并根据实际情况修改

# ==================== 基本配置 ====================

# Broker 对外广播的 IP 地址（必填）
# 说明: 客户端将通过此 IP 连接 Broker
# 开发环境: localhost 或 127.0.0.1
# 生产环境: 服务器公网 IP 或域名
# 示例: BROKER_IP=47.100.200.300 或 BROKER_IP=mq.yourdomain.com
BROKER_IP=your-server-ip

# ==================== 端口配置 ====================

# NameServer 端口（默认: 9876）
NAMESRV_PORT=9876

# Broker 主端口（默认: 10911）
BROKER_PORT=10911

# Broker VIP 通道端口（默认: 10909）
BROKER_VIP_PORT=10909

# ==================== 环境配置 ====================

# Spring Boot 环境配置（dev/prod）
SPRING_PROFILES_ACTIVE=prod

# ==================== JVM 配置 ====================

# JVM 堆内存配置
# 小型项目: -Xms512m -Xmx512m -Xmn256m
# 中型项目: -Xms1g -Xmx1g -Xmn512m
# 大型项目: -Xms2g -Xmx2g -Xmn1g
JAVA_OPTS=-Xms1g -Xmx1g -Xmn512m

# ==================== 数据持久化 ====================

# 数据存储目录（宿主机路径）
DATA_DIR=/data/rocketmq

# ==================== 容器配置 ====================

# 容器名称
CONTAINER_NAME=rocketmq-server

# 容器重启策略（unless-stopped/always/no）
RESTART_POLICY=unless-stopped

# ==================== 网络配置 ====================

# Docker 网络名称
NETWORK_NAME=app-network

# ==================== RocketMQ 配置 ====================

# 是否自动创建 Topic（生产环境建议 false）
AUTO_CREATE_TOPIC=false

# 是否自动创建订阅组（生产环境建议 false）
AUTO_CREATE_SUBSCRIPTION=false

# Broker 名称
BROKER_NAME=LocalBroker-Prod

# 集群名称
CLUSTER_NAME=RuoYiProdCluster
