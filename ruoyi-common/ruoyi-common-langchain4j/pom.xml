<!--            </exclusions>-->
<!--        </dependency>-->

        <!-- ================ 测试依赖 ================ -->
        <!-- 测试基础框架 - 提供单元测试基类与工具 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
