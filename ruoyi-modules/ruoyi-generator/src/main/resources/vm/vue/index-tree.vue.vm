<!-- ${functionName} -->
<template>
  <div>
    <!--  搜索栏   -->
    <ASearchForm ref="queryFormRef" v-model="queryParams" :visible="showSearch">
#foreach($column in $columns)
#if($column.query)
#set($dictType=$column.dictType)
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
#if($column.htmlType == "input" || $column.htmlType == "textarea")
      <AFormInput label="${column.columnLabel}" v-model="queryParams.${column.javaField}" prop="${column.javaField}" @input="handleQuery"></AFormInput>
#elseif(($column.htmlType == "select" || $column.htmlType == "radio") && "" != $dictType)
      <AFormSelect label="${column.columnLabel}" v-model="queryParams.${column.javaField}" prop="${column.javaField}" :options="${dictType}" @change="handleQuery"></AFormSelect>
#elseif(($column.htmlType == "select" || $column.htmlType == "radio") && $dictType)
      <AFormSelect label="${column.columnLabel}" v-model="queryParams.${column.javaField}" prop="${column.javaField}" @change="handleQuery"></AFormSelect>
#elseif($column.htmlType == "datetime" && $column.queryType != "BETWEEN")
      <AFormDate v-model="queryParams.${column.javaField}" type="date" label="${column.columnLabel}" @change="handleQuery"></AFormDate>
#elseif($column.htmlType == "datetime" && $column.queryType == "BETWEEN")
      <AFormDate v-model="dateRange${AttrName}" prop="${column.javaField}" type="daterange" label="${column.columnLabel}" @change="handleQuery"></AFormDate>
#end
#end
#end
    </ASearchForm>

    <el-card shadow="hover">
      <!--   工具栏    -->
      <template #header>
        <el-row :gutter="10" class="mb-2">
          <el-col :span="1.5" v-permi="['${moduleName}:${businessName}:add']">
            <el-button type="primary" plain icon="Plus" @click="handleAdd()">
              {{ t('新增') }}
            </el-button>
          </el-col>
          <el-col :span="1.5">
            <el-button type="info" plain icon="Sort" @click="toggleAllExpansion">
              {{ isAllExpanded ? t('折叠') : t('展开') }}
            </el-button>
          </el-col>
          <TableToolbar v-model:showSearch="showSearch" @reset-query="resetQuery" @query-table="getList"></TableToolbar>
        </el-row>
      </template>

      <!--   表格数据  -->
      <el-table
        ref="${businessName}TableRef"
        v-loading="isLoading"
        :data="${businessName}List"
        :height="tableHeight"
        row-key="${treeCode}"
        :tree-props="{ children: 'children', hasChildren: 'hasChildren' }"
        :default-expand-all="isAllExpanded"
      >
#set($treeNodeAdded = false)
#foreach($column in $columns)
#set($javaField=$column.javaField)
#if($column.pk)
#elseif($javaField == $treeName && !$treeNodeAdded)
#set($treeNodeAdded = true)
        <el-table-column :label="t('${javaField}', '${column.columnLabel}')" prop="${javaField}" align="left" />
#elseif($column.list && $column.htmlType == "datetime")
        <el-table-column :label="t('${javaField}', '${column.columnLabel}')" prop="${javaField}" align="center" />
#elseif($column.list && $column.htmlType == "imageUpload")
        <el-table-column :label="t('${javaField}', '${column.columnLabel}')" prop="${javaField}" align="center" width="80">
          <template #default="{ row }">
            <ImagePreview :src="row.${javaField}" />
          </template>
        </el-table-column>
#elseif($column.list && $column.htmlType == "fileUpload")
        <el-table-column :label="t('${javaField}', '${column.columnLabel}')" prop="${javaField}" align="center">
          <template #default="{ row }">
            <el-link v-if="row.${javaField}" type="primary" :href="row.${javaField}" target="_blank">查看附件</el-link>
            <span v-else>-</span>
          </template>
        </el-table-column>
#elseif($column.list && $column.javaField == "status")
        <el-table-column :label="t('${javaField}', '${column.columnLabel}')" prop="${javaField}" align="center">
          <template #default="{ row }">
            <AFormSwitch v-model="row.${javaField}" @change="handleStatusChange(row)" />
          </template>
        </el-table-column>
#elseif($column.list && $column.dictType && "" != $column.dictType)
        <el-table-column :label="t('${javaField}', '${column.columnLabel}')" prop="${javaField}" align="center">
          <template #default="{ row }">
            <DictTag :options="${column.dictType}" :value="row.${javaField}" />
          </template>
        </el-table-column>
#elseif($column.list && "" != $javaField)
        <el-table-column :label="t('${javaField}', '${column.columnLabel}')" prop="${javaField}" align="center" />
#end
#end
#if(!$treeNodeAdded)
        <el-table-column :label="t('${treeName}', '${treeName}')" prop="${treeName}" align="left" />
#end
        <el-table-column :label="t('操作')" align="center" fixed="right">
          <template #default="{ row }">
            <el-tooltip :content="t('修改')" placement="top">
              <el-button v-permi="['${moduleName}:${businessName}:update']" link type="success" icon="Edit" @click="handleUpdate(row)"></el-button>
            </el-tooltip>
            <el-tooltip :content="t('新增')" placement="top">
              <el-button v-permi="['${moduleName}:${businessName}:add']" link type="primary" icon="Plus" @click="handleAdd(row)"></el-button>
            </el-tooltip>
            <el-tooltip :content="t('删除')" placement="top">
              <el-button v-permi="['${moduleName}:${businessName}:delete']" link type="danger" icon="Delete" @click="handleDelete(row)"></el-button>
            </el-tooltip>
          </template>
        </el-table-column>
      </el-table>
    </el-card>

    <!-- 添加或修改${functionName}对话框 -->
    <AModal v-model="dialog.visible" :title="dialog.title" size="small" :loading="buttonLoading" @confirm="submitForm" @cancel="cancel">
      <el-form ref="${businessName}FormRef" :model="form" :rules="rules" label-width="auto">
        <el-row :gutter="10">
#foreach($column in $columns)
#set($field=$column.javaField)
#if(($column.insert || $column.edit) && !$column.pk)
#set($dictType=$column.dictType)
#if("" != $treeParentCode && $column.javaField == $treeParentCode)
          <AFormTreeSelect label="${column.columnLabel}" v-model="form.${treeParentCode}" prop="${treeParentCode}" :data="${businessName}Options"
              :props="{ value: '${treeCode}', label: '${treeName}', children: 'children' }" span="auto"></AFormTreeSelect>
#elseif($column.htmlType == "input")
#if($column.columnLength)
          <AFormInput label="${column.columnLabel}" v-model="form.${field}" :maxlength="$column.columnLength" prop="${field}" span="auto"></AFormInput>
#else
          <AFormInput label="${column.columnLabel}" v-model="form.${field}" prop="${field}" span="auto"></AFormInput>
#end
#elseif($column.htmlType == "imageUpload")
          <AFormImgUpload label="${column.columnLabel}" v-model="form.${field}" prop="${field}" span="auto"></AFormImgUpload>
#elseif($column.htmlType == "fileUpload")
          <AFormFileUpload label="${column.columnLabel}" v-model="form.${field}" prop="${field}" span="auto"></AFormFileUpload>
#elseif($column.htmlType == "editor")
          <AFormEditor label="${column.columnLabel}" v-model="form.${field}" prop="${field}" span="auto"></AFormEditor>
#elseif($column.htmlType == "select" && "" != $dictType)
          <AFormSelect label="${column.columnLabel}" v-model="form.${field}" prop="${field}" :options="${dictType}" span="auto"></AFormSelect>
#elseif($column.htmlType == "select" && $dictType)
          <AFormSelect label="${column.columnLabel}" v-model="form.${field}" prop="${field}" span="auto"></AFormSelect>
#elseif($column.htmlType == "checkbox" && "" != $dictType)
          <AFormCheckbox label="${column.columnLabel}" v-model="form.${field}" prop="${field}" :options="${dictType}" span="auto"></AFormCheckbox>
#elseif($column.htmlType == "checkbox" && $dictType)
          <AFormCheckbox label="${column.columnLabel}" v-model="form.${field}" prop="${field}" span="auto"></AFormCheckbox>
#elseif($column.htmlType == "radio" && "" != $dictType)
          <AFormRadio label="${column.columnLabel}" v-model="form.${field}" prop="${field}" :options="${dictType}" span="auto"></AFormRadio>
#elseif($column.htmlType == "radio" && $dictType)
          <AFormRadio label="${column.columnLabel}" v-model="form.${field}" prop="${field}" span="auto"></AFormRadio>
#elseif($column.htmlType == "datetime")
          <AFormDate v-model="form.${field}" type="datetime" label="${column.columnLabel}" prop="${field}" span="auto"></AFormDate>
#elseif($column.htmlType == "textarea")
#if($column.columnLength)
          <AFormInput label="${column.columnLabel}" v-model="form.${field}" type="textarea" :maxlength="$column.columnLength" prop="${field}" span="auto"></AFormInput>
#else
          <AFormInput label="${column.columnLabel}" v-model="form.${field}" type="textarea" prop="${field}" span="auto"></AFormInput>
#end
#end
#end
#end
        </el-row>
      </el-form>
    </AModal>
  </div>
</template>

<script setup lang="ts" name="${BusinessName}">
import { page${BusinessName}${pluralSuffix}, get${BusinessName}, add${BusinessName}, update${BusinessName}, delete${BusinessName}${pluralSuffix} } from '@/api/${frontendPath}/${businessName}/${businessName}Api'
import type { ${ClassName}Query, ${ClassName}Bo, ${ClassName}Vo } from '@/api/${frontendPath}/${businessName}/${businessName}Types'
import { isTrue, toggleStatus } from '@/utils/boolean'
import { addDateRange } from '@/utils/date'
import { toValidate } from '@/utils/to'
import { buildTree } from '@/utils/tree'
import { showMsgSuccess, showConfirm } from '@/utils/modal'
#if(${dicts} != '')

#set($dictsNoSymbol=$dicts.replace("'", ""))
#set($hasCustomDict = false)
#foreach($dict in $dictsNoSymbol.split(", "))
#if(!$dict.startsWith("sys_"))
#set($hasCustomDict = true)
#break
#end
#end
#if($hasCustomDict)
/**
 * 🔴 请将以下字典类型添加到 src/composables/useDict.ts 的 DictTypes 枚举中：
 *
 * export enum DictTypes {
 *   // ... 现有字典 ...
#foreach($dict in $dictsNoSymbol.split(", "))
#if(!$dict.startsWith("sys_"))
#if($dictComments.get($dict))
 *  // ${dictComments.get($dict)}
#else
 *   // 补充字典注释
#end
 *   ${dict} = '${dict}',
#end
#end
 * }
 */
#end
/** ${functionName}字典数据 */
const { ${dictsNoSymbol} } = useDict(#foreach($dict in $dictsNoSymbol.split(", "))DictTypes.${dict}#if($foreach.hasNext), #end#end)
#end

type ${ClassName}Option = {
  ${treeCode}: number
  ${treeName}: string
  children?: ${ClassName}Option[]
}

const { t } = useI18n()

// 使用表格高度处理钩子
const { tableHeight, queryFormRef, showSearch } = useTableHeight()

// =========== 查询相关 ===========
#foreach ($column in $columns)
#if($column.htmlType == 'datetime' && $column.queryType == 'BETWEEN')
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
/**日期范围选择器*/
const dateRange${AttrName} = ref<[ElDateModelType, ElDateModelType]>(['', ''])
#end
#end

/**查询参数对象*/
const queryParams = ref<${ClassName}Query>({
#foreach ($column in $columns)
#if($column.query)
#if($column.htmlType != 'datetime' || $column.queryType != 'BETWEEN')
  $column.javaField: undefined,
#end
#end
#end
})

/** ${functionName}搜索按钮操作 */
const handleQuery = () => {
  getList()
}

/** ${functionName}重置按钮操作 */
const resetQuery = () => {
#foreach ($column in $columns)
#if($column.htmlType == 'datetime' && $column.queryType == 'BETWEEN')
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
  dateRange${AttrName}.value = ['', '']
#end
#end
  queryFormRef.value?.resetFields()
  handleQuery()
}

// =========== ${functionName}表格数据相关 ===========
/**表格加载状态*/
const isLoading = ref(true)
/**树形数据列表*/
const ${businessName}List = ref<${ClassName}Vo[]>([])
/**表格实例*/
const ${businessName}TableRef = ref()
/**是否展开所有节点*/
const isAllExpanded = ref(true)

/** 查询${functionName}列表 */
const getList = async () => {
  isLoading.value = true
#foreach ($column in $columns)
#if($column.htmlType == 'datetime' && $column.queryType == 'BETWEEN')
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
  addDateRange(queryParams.value, dateRange${AttrName}.value, '${column.javaField}')
#end
#end
  const [err, data] = await page${BusinessName}${pluralSuffix}(queryParams.value)
  if (!err) {
    const tree = buildTree<${ClassName}Vo>(data.records, {
      id: '${treeCode}',
      parentId: '${treeParentCode}'
    })
    if (tree) {
      ${businessName}List.value = tree
    }
  }
  isLoading.value = false
}

/** 切换全部展开/折叠状态 */
const toggleAllExpansion = () => {
  isAllExpanded.value = !isAllExpanded.value
  setAllRowsExpansion(${businessName}List.value, isAllExpanded.value)
}

/** 递归设置所有行的展开/折叠状态 */
const setAllRowsExpansion = (data: ${ClassName}Vo[], shouldExpand: boolean) => {
  data.forEach((item: ${ClassName}Vo) => {
    ${businessName}TableRef.value?.toggleRowExpansion(item, shouldExpand)
    if (item.children?.length) {
      setAllRowsExpansion(item.children, shouldExpand)
    }
  })
}

/** 删除${functionName}操作 */
const handleDelete = async (row: ${ClassName}Vo) => {
  const [confirmErr] = await showConfirm(#[[`${t('是否确认删除')}${row.]]#${pkColumn.javaField}#[[}`]]#)
  if (confirmErr) return

  isLoading.value = true
  const [err] = await delete${BusinessName}${pluralSuffix}(row.${pkColumn.javaField})
  if (!err) {
    showMsgSuccess(t('message.deleteSuccess'))
    await getList()
  }
  isLoading.value = false
}

// =========== ${functionName}表单相关 ===========
/**初始表单数据*/
const initFormData: ${ClassName}Bo = {
#foreach ($column in $columns)
#if($column.insert || $column.edit)
#if($column.htmlType == 'checkbox')
  $column.javaField: []#if($foreach.count != $columns.size()),#end
#else
  $column.javaField: #if($column.columnDefault && $column.columnDefault != '')$column.columnDefault#{else}undefined#end#if($foreach.count != $columns.size()),#end
#end
#end
#end
}

/**表单引用*/
const ${businessName}FormRef = ref<ElFormInstance>()
/**表单提交按钮加载状态*/
const buttonLoading = ref(false)
/**对话框配置对象*/
const dialog = ref<DialogState>({
  visible: false,
  title: ''
})
/**表单数据对象*/
const form = ref<${ClassName}Bo>({ ...initFormData })
/**下拉树选项*/
const ${businessName}Options = ref<${ClassName}Option[]>([])
/**表单校验规则*/
const rules = ref<ElFormRules>({
#foreach ($column in $columns)
#if(($column.insert || $column.edit) && $column.required)
  $column.javaField: [{ required: true, message: t('$column.javaField cannot be empty', '${column.columnLabel}不能为空'), trigger: #if($column.htmlType == 'select' || $column.htmlType == 'radio')'change'#else'blur'#end }]#if($foreach.count != $columns.size()),#end
#end
#end
})

/** 查询${functionName}下拉树结构 */
const getTreeOptions = async () => {
  const [err, data] = await page${BusinessName}${pluralSuffix}()
  if (!err) {
    ${businessName}Options.value = []
    const tree: ${ClassName}Option = { ${treeCode}: 0, ${treeName}: '顶级节点', children: [] }
    tree.children = buildTree<${ClassName}Option>(data.records, {
      id: '${treeCode}',
      parentId: '${treeParentCode}'
    })
    ${businessName}Options.value.push(tree)
  }
}

/** ${functionName}表单重置 */
const reset = () => {
  form.value = { ...initFormData }
  ${businessName}FormRef.value?.resetFields()
}

/** 取消${functionName}编辑 */
const cancel = () => {
  reset()
  dialog.value.visible = false
}

/** 新增${functionName}按钮操作 */
const handleAdd = (row?: ${ClassName}Vo) => {
  reset()
  getTreeOptions()
  form.value.${treeParentCode} = row?.${treeCode} || 0
  dialog.value.visible = true
  dialog.value.title = #[[`${t('新增')}${t(']]#${businessName}#[[', ']]#${functionName}#[[')}`]]#
}

/** 修改${functionName}按钮操作 */
const handleUpdate = async (row: ${ClassName}Vo) => {
  reset()
  await getTreeOptions()
  if (row) {
    form.value.${treeParentCode} = row.${treeParentCode}
  }
  const [err, data] = await get${BusinessName}(row.${pkColumn.javaField})
  if (!err) {
    form.value = data
    dialog.value.visible = true
    dialog.value.title = #[[`${t('修改')}${t(']]#${businessName}#[[', ']]#${functionName}#[[')}`]]#
  }
}

/** 提交${functionName}表单 */
const submitForm = async () => {
  const [validateErr] = await toValidate(${businessName}FormRef)
  if (validateErr) return

  buttonLoading.value = true
  let err: Error | null
  if (form.value.${pkColumn.javaField}) {
    ;[err] = await update${BusinessName}(form.value)
  } else {
    ;[err] = await add${BusinessName}(form.value)
  }
  if (!err) {
    showMsgSuccess(form.value.${pkColumn.javaField} ? t('message.updateSuccess') : t('message.addSuccess'))
    dialog.value.visible = false
    await getList()
  }
  buttonLoading.value = false
}

#set($hasStatusField = false)
#foreach($column in $columns)
#if($column.javaField == "status")
#set($hasStatusField = true)
#break
#end
#end
#if($hasStatusField)
/** ${functionName}启用禁用状态修改 */
const handleStatusChange = async (row: ${ClassName}Vo) => {
  const text = isTrue(row.status) ? t('启用') : t('停用')
  const [confirmErr] = await showConfirm(#[[`${t('是否确认')}${text}${row.]]#${pkColumn.javaField}#[[}?`]]#)
  if (confirmErr) {
    row.status = toggleStatus(row.status)
    return
  }
  const [updateErr] = await update${BusinessName}(row)
  if (!updateErr) {
    await getList()
    showMsgSuccess(#[[`${text}${t('成功')}`]]#)
  } else {
    row.status = toggleStatus(row.status)
  }
}
#end

// =========== 生命周期 ===========
/**初始化${functionName}数据列表*/
onMounted(() => {
  getList()
})
/**页面激活时刷新${functionName}列表*/
onActivated(() => {
  if (isLoading.value) return
  getList()
})
</script>

<style lang="scss" scoped>
/* 解决树形数据展开箭头与文本不在同一行的问题 */
:deep(.el-table__body tr td:first-child .cell) {
  display: flex;
  align-items: center;
}
</style>
