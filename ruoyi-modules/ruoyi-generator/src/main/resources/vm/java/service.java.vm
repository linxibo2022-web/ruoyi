package ${packageName}.service;

import ${packageName}.domain.bo.${ClassName}Bo;
import ${packageName}.domain.vo.${ClassName}Vo;
import plus.ruoyi.common.mybatis.core.page.PageQuery;
import plus.ruoyi.common.mybatis.core.page.PageResult;

import java.util.Collection;
import java.util.List;

/**
 * ${functionName}服务接口
 *
 * @author ${author}
 * @date ${datetime}
 */
public interface I${ClassName}Service {

    /**
     * 根据ID查询
     *
     * @param ${pkColumn.javaField} 主键ID
     * @return 视图对象
     */
    ${ClassName}Vo get(${pkColumn.javaType} ${pkColumn.javaField});

    /**
     * 查询列表
     *
     * @param bo 查询参数
     * @return 列表数据
     */
    List<${ClassName}Vo> list(${ClassName}Bo bo);

    /**
     * 分页查询
     *
     * @param bo        查询参数
     * @param pageQuery 分页参数
     * @return 分页结果
     */
    PageResult<${ClassName}Vo> page(${ClassName}Bo bo, PageQuery pageQuery);

    /**
     * 新增
     *
     * @param bo 业务对象
     * @return 主键ID
     */
    ${pkColumn.javaType} add(${ClassName}Bo bo);

    /**
     * 修改
     *
     * @param bo 业务对象
     * @return 影响行数
     */
    int update(${ClassName}Bo bo);

    /**
     * 批量删除
     *
     * @param ids ID集合
     * @return 影响行数
     */
    int batchDelete(Collection<${pkColumn.javaType}> ids);

    /**
     * 批量保存
     *
     * @param boList 业务对象集合
     * @return 影响行数
     */
    int batchSave(List<${ClassName}Bo> boList);

    /**
     * 查询选项列表
     * 用于下拉选择、关联查询等场景,只返回必要字段
     *
     * @return 选项列表
     */
    List<${ClassName}Vo> listForOption();
}
