<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>plus.ruoyi</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-mall</artifactId>

    <description>
        商城模块 - 包含商品、订单、购物车等商城业务逻辑
    </description>

    <dependencies>
        <!-- ================ 核心基础依赖 ================ -->
        <!-- 核心模块 - 提供基础工具类与通用功能 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <!-- Web服务模块 - 提供Web应用支持 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <!-- 缓存服务模块 - 提供Redis缓存支持 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-redis</artifactId>
        </dependency>

        <!-- ================ 安全与认证依赖 ================ -->
        <!-- 安全模块 - 提供权限控制 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-security</artifactId>
        </dependency>

        <!-- 加密模块 - 提供数据加解密功能 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-encrypt</artifactId>
        </dependency>

        <!-- 数据脱敏模块 - 提供敏感数据处理 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-sensitive</artifactId>
        </dependency>

        <!-- ================ 数据处理依赖 ================ -->
        <!-- 数据库服务模块 - 提供MyBatis增强支持 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <!-- Excel处理模块 - 提供Excel导入导出 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-excel</artifactId>
        </dependency>

        <!-- 多租户模块 - 提供多租户支持 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-tenant</artifactId>
        </dependency>

        <!-- 序列化映射模块 - 提供数据字典翻译 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-serialmap</artifactId>
        </dependency>

        <!-- ================ 系统功能依赖 ================ -->
        <!-- 日志模块 - 提供操作日志记录 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>

        <!-- 接口文档模块 - 提供API文档 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-doc</artifactId>
        </dependency>

        <!-- 幂等控制模块 - 防止重复提交 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-idempotent</artifactId>
        </dependency>

        <!-- 限流模块 - 提供接口限流能力 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-ratelimiter</artifactId>
        </dependency>

        <!-- ================ 支付模块依赖 ================ -->
        <!-- 支付核心模块 - 提供支付核心功能 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-pay-core</artifactId>
        </dependency>

        <!-- 微信支付模块 - 提供微信支付功能 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-pay-wechat</artifactId>
        </dependency>

        <!-- 支付宝支付模块 - 提供支付宝支付功能 -->
        <!-- ⚠️ 默认注释以减少打包体积，如需使用请取消注释 -->
        <!--
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-pay-alipay</artifactId>
        </dependency>
        -->

        <!-- 余额支付模块 - 提供余额支付功能 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-pay-balance</artifactId>
        </dependency>

        <!-- ================ 微信模块依赖 ================ -->
        <!-- 微信小程序模块 - 提供小程序支持 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-miniapp</artifactId>
        </dependency>

        <!-- 微信公众号模块 - 提供公众号支持 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-mp</artifactId>
        </dependency>

        <!-- ================ 其他业务依赖 ================ -->
        <!-- 媒体处理服务 -->
        <dependency>
            <groupId>plus.ruoyi</groupId>
            <artifactId>ruoyi-common-media</artifactId>
        </dependency>
    </dependencies>
</project>
